# Rebuild the original Phase 8 MinIO release after upstream removed its image.
# Source, compiler and runtime are immutable; no latest tag or third-party mirror.
FROM golang:1.26.7-bookworm@sha256:e8c859f5632dcfde7b32d2012b4351728f6437930887c2f6a91ea242459e5514 AS builder
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /src
ADD --checksum=sha256:f31b6997fdb098479ddddfca1267f02518ee0b59cc1d3f9682c3a48e6309f4d0 https://codeload.github.com/minio/minio/tar.gz/7ced9663e6a791fef9dc6be798ff24cda9c730ac /tmp/minio.tar.gz
RUN tar -xzf /tmp/minio.tar.gz --strip-components=1 -C /src
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download && go mod verify && \
    go build -mod=readonly -trimpath -buildvcs=false \
      -ldflags='-s -w -X github.com/minio/minio/cmd.Version=2025-07-23T15:54:02Z -X github.com/minio/minio/cmd.ReleaseTag=RELEASE.2025-07-23T15-54-02Z -X github.com/minio/minio/cmd.CommitID=7ced9663e6a791fef9dc6be798ff24cda9c730ac' \
      -o /out/minio .

FROM python:3.12.14-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.revision="7ced9663e6a791fef9dc6be798ff24cda9c730ac" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
RUN addgroup --system app && adduser --system --ingroup app --home /data app && \
    mkdir -p /data && chown app:app /data
COPY --from=builder /out/minio /usr/local/bin/minio
COPY --from=builder /src/LICENSE /licenses/LICENSE
COPY --from=builder /src/CREDITS /licenses/CREDITS
USER app
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]
