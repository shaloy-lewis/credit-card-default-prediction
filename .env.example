# Phase 8 local-only credentials. Copy this file to `.env` and replace every
# `change-me` value before starting the stack. `.env` is intentionally ignored.
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me-postgres-local-secret
MINIO_ROOT_USER=mlflow
MINIO_ROOT_PASSWORD=change-me-minio-local-secret
MLFLOW_ARTIFACT_BUCKET=credit-risk-mlflow
