FROM python:3.12.14-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254 AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11.28@sha256:0f36cb9361a3346885ca3677e3767016687b5a170c1a6b88465ec14aefec90aa /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /app

COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-editable --extra platform

FROM python:3.12.14-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254 AS runtime

ENV PATH="/app/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

RUN addgroup --system app && adduser --system --ingroup app --home /app app
COPY --from=builder --chown=app:app /app/.venv /app/.venv
COPY --chown=app:app configs/platform/phase8_v1.json ./configs/platform/phase8_v1.json
COPY --chown=app:app configs/registry/phase7_v1.json ./configs/registry/phase7_v1.json
COPY --chown=app:app configs/registry/phase7_rollback_approval.json ./configs/registry/phase7_rollback_approval.json
COPY --chown=app:app reports/registry/phase7_v1/evidence-manifest.json ./reports/registry/phase7_v1/evidence-manifest.json
COPY --chown=app:app models/selected_v1/manifest.json models/selected_v1/model.cbm ./models/selected_v1/

USER app
EXPOSE 5000
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", "--workers", "1"]
