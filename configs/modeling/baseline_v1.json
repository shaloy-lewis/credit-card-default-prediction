        4,
        3,
        2,
        1
      ],
      "negative_value_floor": 0,
      "aggregation": "sum"
    },
    "logistic": {
      "model_id": "logistic_l2",
      "kind": "logistic_regression",
      "prediction_kind": "probability",
      "status_columns": [
        "repayment_status_lag_0",
        "repayment_status_lag_1",
        "repayment_status_lag_2",
        "repayment_status_lag_3",
        "repayment_status_lag_4",
        "repayment_status_lag_5"
      ],
      "status_encoding": "one_hot",
